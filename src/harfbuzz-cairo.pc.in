prefix=${pcfiledir}/../..
exec_prefix=${pcfiledir}/../..
libdir=${prefix}/lib
includedir=${prefix}/include

Name: harfbuzz cairo integration
Description: HarfBuzz cairo integration
Version: %VERSION%

Requires: harfbuzz = %VERSION%
Libs: -L${libdir} -lharfbuzz-cairo
Cflags: -I${includedir}/harfbuzz
